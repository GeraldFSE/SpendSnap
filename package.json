{
  "name": "spendsnap",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:functions": "npm --prefix functions test",
    "test:system": "firebase emulators:exec --only firestore \"node --test system-tests/firestore.test.mjs\"",
    "test:all": "jest && npm run test:functions && npm run test:system"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@firebase/app": "0.10.13",
    "@firebase/auth": "1.7.9",
    "@firebase/firestore": "4.7.3",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/native": "^7.1.17",
    "expo": "~54.0.35",
    "expo-dev-client": "~6.0.21",
    "expo-notifications": "~0.32.17",
    "expo-quick-actions": "^6.0.0",
    "expo-status-bar": "~3.0.9",
    "firebase": "^10.14.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-refresh": "^0.14.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@testing-library/react-native": "^13.3.3",
    "babel-preset-expo": "~54.0.10",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0"
  }
}
