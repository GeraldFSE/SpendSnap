rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // True only when the sole change to `members` is the caller adding their own key
    // (an invite-code join) -- no other key may be added, removed, or changed.
    function isSelfJoin(existingMembers, incomingMembers) {
      let membersDiff = existingMembers.diff(incomingMembers);
      return membersDiff.addedKeys().hasOnly([request.auth.uid])
        && membersDiff.removedKeys().size() == 0
        && membersDiff.changedKeys().size() == 0;
    }

    // Membership lookup table for shared budgets. Members is a map of uid -> true
    // so rules can check membership without reading an array.
    match /groups/{groupId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.members;
      // Groups are joined by a known id/invite code, not discovered via query.
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] == true;

      allow update: if isSignedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          request.auth.uid in resource.data.members
          || isSelfJoin(resource.data.members, request.resource.data.members)
        );

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {

      match /expenses/{expenseId} {
        allow read: if isSignedIn()
          && (request.auth.uid == userId || isGroupMember(resource.data.groupId));

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == userId
          && (request.resource.data.groupId == userId || isGroupMember(request.resource.data.groupId));

        allow update, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /settings/{settingId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // The nested match above only governs direct-path/subcollection access. A
    // collectionGroup("expenses") query is a separate request shape that's only
    // eligible under a recursive-wildcard match, so it needs its own read rule here.
    // List-time rule evaluation can only see resource.data fields referenced by the
    // query's filters/orderBy (groupId, date) -- resource.data.userId isn't part of
    // the query and reading it throws "Property userId is undefined", so the owner
    // check has to go through groupId (which defaults to the owner's own uid) instead.
    match /{path=**}/expenses/{expenseId} {
      allow read: if isSignedIn()
        && (resource.data.groupId == request.auth.uid || isGroupMember(resource.data.groupId));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}