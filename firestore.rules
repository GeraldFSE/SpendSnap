rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The set of group ids the caller currently belongs to (or [] before they join any).
    // Used to authorize reading fellow group members' expenses without a per-doc get().
    function callerGroupIds() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/settings/groups)
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)/settings/groups).data.get('ids', [])
        : [];
    }

    // An invite-code join: the only change to `members` is the caller adding their own
    // key as `true`, and they weren't already a member. affectedKeys() is direction-
    // independent, so this avoids the addedKeys()/removedKeys() orientation pitfall.
    function isSelfJoin(existingMembers, incomingMembers) {
      return incomingMembers.diff(existingMembers).affectedKeys().hasOnly([request.auth.uid])
        && incomingMembers[request.auth.uid] == true
        && !(request.auth.uid in existingMembers);
    }

    // Membership lookup table for shared budgets. Members is a map of uid -> true
    // so rules can check membership without reading an array.
    match /groups/{groupId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.members;
      // Groups are joined by a known id/invite code, not discovered via query.
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] == true;

      allow update: if isSignedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          request.auth.uid in resource.data.members
          || isSelfJoin(resource.data.members, request.resource.data.members)
        );

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {

      // Direct/own-subcollection access. Home, Summary and History read the caller's
      // own expenses through this path; cross-member group reads go through the
      // collection-group rule below instead.
      match /expenses/{expenseId} {
        allow read: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == userId;

        allow update, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /settings/{settingId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // A collectionGroup("expenses") query (used by the Group tab) is a distinct request
    // shape only eligible under a recursive-wildcard match. List-time evaluation can only
    // read fields the query filters/orders on (groupIds, date), so the rule must touch
    // nothing else: a caller may read an expense if they share a group with its author.
    match /{path=**}/expenses/{expenseId} {
      allow read: if isSignedIn()
        && resource.data.get('groupIds', []).hasAny(callerGroupIds());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
