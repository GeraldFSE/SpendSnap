rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /expenses/{expenseId} {
      // Development MVP rule for the unauthenticated Firestore prototype.
      // Require Firebase Auth and user-scoped paths before shipping.
      allow read, write: if true;
    }

    match /users/{userId}/{document=**} {
      // TODO: Replace this placeholder with authenticated ownership checks before shipping.
      // Description: Only the signed-in owner should read or write their expenses, budgets,
      // parser feedback, and settings. During early prototyping, keep test data separate.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
