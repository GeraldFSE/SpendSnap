{
  "expo": {
    "name": "SpendSnap",
    "slug": "spendsnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spendsnap",
    "jsEngine": "jsc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spendsnap.app"
    },
    "android": {
      "package": "com.spendsnap.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "plugins": [
      "expo-quick-actions"
    ]
  }
}
