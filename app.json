{
  "expo": {
    "name": "SpendSnap",
    "slug": "spendsnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spendsnap",
    "jsEngine": "jsc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spendsnap.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spendsnap.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "plugins": [
      "expo-quick-actions"
    ],
    "extra": {
      "eas": {
        "projectId": "c5741554-e3fe-4548-9b5a-d992e7daadae"
      }
    },
    "owner": "bluueyz"
  }
}
